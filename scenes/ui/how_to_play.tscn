[node name="Level2Heading" type="Label" parent="Foreground/Column/Panel/Padding/Scroll/Steps"]
layout_mode = 2
theme_type_variation = &"BodyText"
theme_override_colors/font_color = Color(0.19, 0.47, 0.13, 1)
