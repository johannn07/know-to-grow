# Godot 4
.godot/
/android/
*.translation

# export_presets.cfg is deliberately tracked: it holds the package name,
# target architectures and SDK levels, which are worth versioning. The
# keystore paths and passwords live in .godot/export_credentials.cfg,
# which is ignored with the rest of .godot/.

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Builds
/build/
*.apk
*.aab
*.keystore

# Exported builds (web zip, APK) — made from the editor, never committed.
# builds/.gdignore stays, so Godot never imports an exported build back in.
builds/*
!builds/.gdignore
