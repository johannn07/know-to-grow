; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Know To Grow"
run/main_scene="uid://owlhlu6rt330"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/art/branding/icon_app_1024.png"
boot_splash/bg_color=Color(0.992157, 0.960784, 0.886275, 1)
boot_splash/image="res://assets/art/branding/ui_boot_splash.png"
boot_splash/minimum_display_time=1500

[audio]

buses/default_bus_layout="uid://b1u1cpgmh3dwe"

[autoload]

GameState="*res://scripts/core/game_state.gd"
AudioDirector="*res://scenes/core/audio_director.tscn"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/resizable=false
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
